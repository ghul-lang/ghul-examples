<Project Sdk="Microsoft.NET.Sdk">
  <!-- this dummy project is needed by the ghūl VSCode language extension: it uses it to find the reference assemblies -->
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler --entry root_entry</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="examples/**/*.ghul" />
    <GhulSources Include="root/**/*.ghul" />

    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. The per-test projects compile the same
         files via symlinks, so this umbrella is the single gate. -->
    <!-- Each example piece is its own program of top-level statements; here,
         where root_entry is the entry point, none of them runs. -->
    <GhulOptions Include="--suppress top-level-statements-not-run" />

    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
  </ItemGroup>
</Project>
