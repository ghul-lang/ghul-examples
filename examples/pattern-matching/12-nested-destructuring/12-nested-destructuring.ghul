use IO.Std.write_line
use Colour.*
use Tree.*

// patterns nest. this is Okasaki's red-black tree rebalance, which matches a
// 4-tuple against enum values and variant patterns three levels deep. a bare
// name in a pattern declares a new variable, so ~RED is written to match the
// imported enum member instead

enum Colour is
    RED,
    BLACK,
si

union Tree is
    EMPTY
    NODE(colour: Colour, left: Tree, value: int, right: Tree)
si

balance(colour: Colour, left: Tree, value: int, right: Tree) -> Tree =>
    case (colour, left, value, right)
    when (~BLACK, (~RED, (~RED, a, x, b): NODE, y, c): NODE, z, d) then
        NODE(RED, NODE(BLACK, a, x, b), y, NODE(BLACK, c, z, d))
    when (~BLACK, (~RED, a, x, (~RED, b, y, c): NODE): NODE, z, d) then
        NODE(RED, NODE(BLACK, a, x, b), y, NODE(BLACK, c, z, d))
    when (~BLACK, a, x, (~RED, (~RED, b, y, c): NODE, z, d): NODE) then
        NODE(RED, NODE(BLACK, a, x, b), y, NODE(BLACK, c, z, d))
    when (~BLACK, a, x, (~RED, b, y, (~RED, c, z, d): NODE): NODE) then
        NODE(RED, NODE(BLACK, a, x, b), y, NODE(BLACK, c, z, d))
    else
        NODE(colour, left, value, right)
    esac

ins(t: Tree, v: int) -> Tree =>
    if let (colour, left, value, right): NODE = t then
        if v < value then
            balance(colour, ins(left, v), value, right)
        elif v > value then
            balance(colour, left, value, ins(right, v))
        else
            t
        fi
    else
        NODE(RED, EMPTY, v, EMPTY)
    fi

// the root of ins() may come out red; a real red-black insert always
// re-blackens the root before handing the tree back to the caller
blacken(t: Tree) -> Tree =>
    case t
    when n: NODE then NODE(BLACK, n.left, n.value, n.right)
    else t
    esac

insert_value(t: Tree, v: int) -> Tree => blacken(ins(t, v))

count(t: Tree) -> int =>
    case t
    when n: NODE then 1 + count(n.left) + count(n.right)
    else 0
    esac

black_height(t: Tree) -> int =>
    case t
    when n: NODE /\ n.colour == BLACK then 1 + black_height(n.left)
    when n: NODE then black_height(n.left)
    else 0
    esac

is_leaf(t: Tree) -> string =>
    // isa narrows t in place, and the else branch to the other variant,
    // since Tree has only two
    if isa NODE(t) then
        "node with value {t.value}"
    else
        "empty"
    fi

let t: Tree mut = EMPTY
for v in [10, 5, 20, 3, 7, 15, 25, 1, 30, 12] do
    t = insert_value(t, v)
od

write_line("tree size: {count(t)}")
write_line("black height: {black_height(t)}")
write_line(is_leaf(EMPTY))
write_line(is_leaf(t))
