use IO.Std.write_line

// the element type comes from the elements: their type where they all
// agree, and their closest common supertype where they don't:
let ints = [1, 2, 3]
let strings = ["one", "two", "three"]

write_line("ints: {ints |> $}")
write_line("strings: {strings |> $}")

// the tuple's element types come from the element expressions:
let person = ("alice", 30)
write_line("person: ({person.`0}, {person.`1})")

// nested:
let nested = (("alice", 30), [1, 2, 3])
write_line("nested.`0.`0: {nested.`0.`0}")
