use IO.Std.write_line
use Ghul.Pipes.map
use Ghul.Pipes.filter
use Ghul.Pipes.reduce

// when a lambda is passed as an argument and the call site's formal
// parameter is a function type, the lambda's parameter types are
// inferred from that signature.

// map[T,U](source: Iterable[T], mapper: T -> U) - x: int comes from the source element type:
let doubled = [1, 2, 3] |> map(x => x * 2)
write_line("doubled: {doubled}")

// filter[T](source: Iterable[T], predicate: T -> bool):
let even = [1, 2, 3, 4, 5, 6] |> filter(x => x % 2 == 0)
write_line("even: {even}")

// reduce[T,TRunning](source, seed, accumulator: (TRunning, T) -> TRunning) - acc and x are both inferred:
let sum = [1, 2, 3, 4, 5] |> reduce(0, (acc, x) => acc + x)
write_line("sum: {sum}")

// chained calls keep flowing the inferred types through:
let labelled = [1, 2, 3] |> map(n => "[{n}]") |> reduce("", (acc, s) => "{acc}{s}")
write_line("labelled: {labelled}")
