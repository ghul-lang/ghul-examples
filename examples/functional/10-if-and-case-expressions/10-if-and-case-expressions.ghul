use IO.Std.write_line

// if is an expression: its value is the value of the branch that runs:
let parity =
    n =>
        if n % 2 == 0 then
            "even"
        else
            "odd"
        fi

write_line("parity(10): {parity(10)}")
write_line("parity(11): {parity(11)}")

// case works the same way when there are more choices. an arm can
// match several values, and the else arm covers the rest:
let describe =
    n =>
        case n
        when -1 then "minus one"
        when 0 then "zero"
        when 1 then "one"
        when 2 then "two"
        when 6, 7, 8 then "small"
        when 13 then "unlucky"
        else "other"
        esac

write_line("describe(-1): {describe(-1)}")
write_line("describe(2): {describe(2)}")
write_line("describe(7): {describe(7)}")
write_line("describe(42): {describe(42)}")
