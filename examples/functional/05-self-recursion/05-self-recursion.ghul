use IO.Std.write_line

// an anonymous function refers to itself through rec
let factorial =
    n rec =>
        if n == 0 then
            1
        else
            n * rec(n - 1)
        fi

write_line("factorial(5): {factorial(5)}")

let fibonacci =
    n rec =>
        if n <= 1 then
            n
        else
            rec(n - 1) + rec(n - 2)
        fi

write_line("fibonacci(5): {fibonacci(5)}")
